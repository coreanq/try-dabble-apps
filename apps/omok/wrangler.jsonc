{
  "name": "omok",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "omok.try-dabble.com/*", "zone_name": "try-dabble.com" }
  ],
  "main": "src/og-lang.ts"
}

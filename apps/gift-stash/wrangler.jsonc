{
  "name": "gift-stash",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "gift-stash.try-dabble.com",
      "custom_domain": true
    }
  ],
  "main": "src/og-lang.ts"
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seatview",
  "compatibility_date": "2026-08-27",
  "assets": {
    // Vite build output (viewer at /, admin tool at /admin/). Hash routing, so
    // the SPA fallback only matters for typos.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "seatview.try-dabble.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
